{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --config testing/jest.config.js testing/unit",
    "test:unit": "jest --runInBand --config testing/jest.config.js testing/unit",
    "test:integration": "jest --runInBand --config testing/jest.config.js testing/integration",
    "test:performance": "artillery run testing/performance/healthlab-low-load.yml --output testing/build/healthlab-low-report.json",
    "test:performance:low": "artillery run testing/performance/healthlab-low-load.yml --output testing/build/healthlab-low-report.json",
    "test:performance:medium": "artillery run testing/performance/healthlab-medium-load.yml --output testing/build/healthlab-medium-report.json",
    "test:performance:high": "artillery run testing/performance/healthlab-high-load.yml --output testing/build/healthlab-high-report.json",
    "test:performance:researcher": "artillery run testing/performance/healthlab-researcher-read-load.yml --output testing/build/healthlab-researcher-report.json",
    "test:performance:report:low": "artillery report testing/build/healthlab-low-report.json --output testing/build/healthlab-low-report.html",
    "test:performance:report:medium": "artillery report testing/build/healthlab-medium-report.json --output testing/build/healthlab-medium-report.html",
    "test:performance:report:high": "artillery report testing/build/healthlab-high-report.json --output testing/build/healthlab-high-report.html",
    "test:performance:report:researcher": "artillery report testing/build/healthlab-researcher-report.json --output testing/build/healthlab-researcher-report.html"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "HealthLab Backend API",
  "dependencies": {
    "@google/genai": "^1.44.0",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.1",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "stripe": "^22.1.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "artillery": "^2.0.22",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.1"
  }
}
